# Copy to .env (never committed) for running the server on your own computer.
# On Render, set these under the service's Environment tab instead.

# MongoDB Atlas connection string, password filled in
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Shared with every Pi (SHELFEYE_DEVICE_TOKEN in /etc/shelfeye/shelfeye.env)
SHELFEYE_DEVICE_TOKEN=change-me

# Email for password resets (Brevo SMTP relay: SMTP & API > SMTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_USER=<your-login>@smtp-brevo.com
SMTP_PASS=<your Brevo SMTP key>
# Must be a verified sender in Brevo
MAIL_FROM=you@example.com
MAIL_FROM_NAME=ShelfEye

# Where the links in emails point (your dashboard's address)
DASHBOARD_URL=http://localhost:3000
