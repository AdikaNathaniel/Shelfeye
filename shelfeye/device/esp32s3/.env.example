# ShelfEye ESP32-S3 settings. Copy this file to data/.env, fill it in, and send it
# to the board's flash with:   pio run -t uploadfs
# (Or, with a microSD card, put it in the card's root as .env instead.)
# The firmware reads it at every start-up; nothing here is compiled into the
# firmware, so changing it never needs a rebuild.

# Unique name for this shelf camera (shows on the dashboard)
SHELFEYE_NODE_ID=shelf-1

# Wi-Fi (2.4 GHz only; the ESP32-S3 can't join 5 GHz networks)
WIFI_SSID=your-wifi-name
WIFI_PASSWORD=your-wifi-password

OPENAI_API_KEY=sk-your-key-here
# Any OpenAI model that accepts images and structured outputs
OPENAI_MODEL=gpt-4.1-mini

# The ShelfEye server, and the device token set on it (SHELFEYE_DEVICE_TOKEN on Render)
SHELFEYE_SERVER_URL=https://shelfeye-server.onrender.com
SHELFEYE_DEVICE_TOKEN=change-me

# Products expected on this shelf, separated by commas (or put a catalog.json
# list next to this file)
CATALOG=Epilim Chrono 300,Epilim Chrono 500

# Seconds between photos
CAPTURE_INTERVAL_SECONDS=180
# Fraction of the image that must change before we call OpenAI (0.01 = 1%)
CHANGE_THRESHOLD=0.01
# Re-count anyway after this many minutes, to correct any drift
RECHECK_MINUTES=30
# Delete stored photos older than this many days (the dashboard's Settings page overrides it)
KEEP_IMAGES_DAYS=365

# Battery saving: "on" puts the ESP32 into deep sleep between photos (a few mA
# instead of ~100 mA), but turns live view off because the device can't listen.
DEEP_SLEEP=off

# Live view in the dashboard ("off" turns it off). Counting pauses while it is open.
LIVE_VIEW=on
# Upper limit on frames a second; the camera usually sets the real rate (see the log)
LIVE_VIEW_FPS=10
LIVE_VIEW_MAX_MINUTES=10
# Fast video straight from the board at http://<board IP>/ for anyone on the same
# Wi-Fi, linked from the dashboard's Cameras page ("off" turns it off). The link's
# key is made on the board itself, so there's nothing to fill in.
LOCAL_VIEW=on

# Counting photo resolution: QXGA (2048x1536, OV3660 only), UXGA (1600x1200),
# SXGA, HD, XGA, SVGA. Higher reads small labels better but uploads more data.
FRAME_SIZE=UXGA
# JPEG quality: 4 (best, biggest) to 63 (worst, smallest)
JPEG_QUALITY=10
