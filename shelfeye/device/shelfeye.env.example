# Copy to /etc/shelfeye/shelfeye.env on the Pi and fill in the values.

# Unique name for this shelf camera
SHELFEYE_NODE_ID=shelf-1

OPENAI_API_KEY=sk-your-key-here
# Any OpenAI model that accepts images and structured outputs
OPENAI_MODEL=gpt-4.1-mini

# Where the ShelfEye server runs, and the shared device token set on the server
SHELFEYE_SERVER_URL=http://192.168.1.50:8000
SHELFEYE_DEVICE_TOKEN=change-me

# Photos and the local database live here (on the SD card)
SHELFEYE_DATA_DIR=/home/pi/shelfeye-data
# JSON list of product names expected on this shelf
SHELFEYE_CATALOG=/etc/shelfeye/catalog.json

# Seconds between photos
CAPTURE_INTERVAL_SECONDS=180
# Fraction of the image that must change before we call OpenAI (0.01 = 1%)
CHANGE_THRESHOLD=0.01
# Re-count anyway after this many minutes, to correct any drift
RECHECK_MINUTES=30
# Delete stored photos older than this many days. The dashboard's Settings page
# overrides this once the camera has reached the server; this value is only used
# until then.
KEEP_IMAGES_DAYS=365

# Live view in the dashboard (0 turns it off). Counting pauses while it is open.
LIVE_VIEW_PORT=8080
# Live view closes itself after this many minutes so counting can continue
LIVE_VIEW_MAX_MINUTES=10
